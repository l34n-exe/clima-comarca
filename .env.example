# Copiá este archivo como .env y ajustá los valores
FLASK_ENV=development
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
CACHE_TTL_CURRENT=600
CACHE_TTL_FORECAST=3600
CACHE_TTL_TIDES=21600
CACHE_TTL_OBSERVATION=600
CACHE_STALE_EXTRA=86400
HTTP_TIMEOUT=8
HTTP_RETRIES=3
HTTP_RETRY_BACKOFF=0.5
WEATHER_MODELS=ecmwf_ifs025,gfs_global,icon_global,gem_global
METAR_URL=https://tgftp.nws.noaa.gov/data/observations/metar/decoded/{station}.TXT
OBSERVATION_MAX_AGE_MIN=180
# Storage del rate limit: vacío = memoria por proceso; redis://... lo
# comparte entre workers (en Render se setea solo desde la Key Value)
# RATE_LIMIT_STORAGE_URI=
